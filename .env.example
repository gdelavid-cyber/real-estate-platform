# REQUIRED DATABASE
DATABASE_URL="postgresql://postgres.xxxxxx:Import671_gdd@aws-0-us-west-1.pooler.supabase.com:5432/postgres?sslmode=require"
# REQUIRED OWNER ACCOUNT
ADMIN_EMAIL=your-email@example.com
ADMIN_PASSWORD=use-a-long-random-password
ADMIN_NAME=Melissa Hatfield
NEXT_PUBLIC_APP_URL=https://your-domain.com

# META CONVERSIONS API — required for real Pixel feedback
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Optional while using Events Manager > Test Events
META_TEST_EVENT_CODE=

# TWILIO — required for real outbound calls and provider callbacks
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1253...

# RESEND — required for real client email, replies, and broadcasts
RESEND_API_KEY=
# Must be a sender/domain verified in Resend
VERIFIED_FROM_EMAIL=Melissa Hatfield <melissa@your-verified-domain.com>

# JARVIS LEAD ASSISTANT (adewaskar/jarvis)
# Clone https://github.com/adewaskar/jarvis, install Claude Code, run npm install,
# then start the bridge with your production origin allowed. Browsers require wss://
# when this application is served over HTTPS.
NEXT_PUBLIC_JARVIS_BRIDGE_URL=wss://your-jarvis-bridge.example.com
# On the bridge host:
# JARVIS_ALLOWED_ORIGINS=https://your-app.vercel.app
# JARVIS_ALLOW_WRITES=0 (recommended; review upstream decideTool before changing)
# JARVIS_MODEL=your-supported-claude-model
# JARVIS_EFFORT=medium

# OPTIONAL OPENCODE SERVER — separate provider-backed tool runtime
OPENCODE_SERVER_URL=https://your-secured-opencode-server.example.com
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=

# LICENSED LISTING DATA — required to display/import real MLS listings
# Obtain access through NWMLS / your approved RESO vendor (Bridge, Trestle, Spark, etc.)
RESO_WEB_API_URL=
RESO_ACCESS_TOKEN=

# OPTIONAL PREMIUM NATURAL VOICE
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
